        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "\ud83d\ude80 Daily AI Tool Tracker Update",
        "message": "=<div style=\"max-width:600px;margin:auto;font-family:Arial,Helvetica,sans-serif;background:#f6f8fb;padding:20px;border-radius:10px;\">\n\n  <h2 style=\"text-align:center;margin-bottom:5px;\">\ud83d\ude80 Daily AI Tool Tracker</h2>\n  <p style=\"text-align:center;color:#666;font-size:14px;margin-top:0;\">\n    Top AI tools from Product Hunt & Hacker News\n  </p>\n\n  {{ $json.items.map((item, index) => `\n    \n    <div style=\"\n      background:#ffffff;\n      padding:14px;\n      margin-top:14px;\n      border-radius:10px;\n      border:1px solid #e5e7eb;\n      box-shadow:0 2px 6px rgba(0,0,0,0.05);\n    \">\n      \n      <div style=\"font-size:12px;color:#888;margin-bottom:6px;\">\n        #${index + 1}\n      </div>\n\n      <h3 style=\"margin:0 0 6px 0;font-size:16px;color:#111;\">\n        ${item.title}\n      </h3>\n\n      <p style=\"margin:0 0 10px 0;font-size:14px;color:#555;line-height:1.4;\">\n        ${item.contentSnippet || \"No description available\"}\n      </p>\n\n      <a href=\"${item.link}\" \n         style=\"\n           display:inline-block;\n           padding:8px 12px;\n           background:#2563eb;\n           color:#fff;\n           text-decoration:none;\n           border-radius:6px;\n           font-size:13px;\n         \">\n         \ud83d\udd17 View Tool\n      </a>\n\n    </div>\n\n  `).join(\"\") }}\n\n  <div style=\"text-align:center;margin-top:20px;font-size:12px;color:#aaa;\">\n    Built with \u2764\ufe0f using n8n\n  </div>\n\n</div>",
        "options": {}
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1776,
        80
      ],
      "id": "389db55d-5656-4588-b1bb-9a1c1d2e67b7",
      "name": "Send a message"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const title = (item.json.title || \"\").toLowerCase();\n  const desc = (item.json.contentSnippet || \"\").toLowerCase();\n  const text = title + \" \" + desc;\n\n  let score = 0;\n\n  // Strong AI signals\n  if (/gpt|llm|transformer/.test(text)) score += 6;\n  if (/agent|autonomous/.test(text)) score += 5;\n\n  // Medium signals\n  if (/ai|artificial intelligence/.test(text)) score += 3;\n\n  // Weak signals\n  if (/assistant|automation|generate|chat/.test(text)) score += 2;\n\n  // Bonus for real product usefulness\n  if (/developer|api|tool|platform|saas/.test(text)) score += 2;\n\n  // Penalize weak/noise content\n  if (/newsletter|course|guide|tips/.test(text)) score -= 2;\n\n  return {\n    json: {\n      ...item.json,\n      score\n    }\n  };\n})\n.sort((a, b) => b.json.score - a.json.score);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        160
      ],
